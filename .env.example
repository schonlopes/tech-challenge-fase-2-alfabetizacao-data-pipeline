# Projeto que pagara as consultas ao BigQuery (a Base dos Dados oferece 1 TB/mes gratuito por projeto).
GCP_PROJECT_ID=seu-projeto-gcp
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp

# Credencial local opcional. Em servicos GCP, prefira Workload Identity/Service Account.
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/credencial.json

# Topico provisionado pelo Terraform para a simulacao de streaming.
PUBSUB_TOPIC=alfabetizacao-alunos-events

